#!/bin/sh
# Runs before tailscaled starts (ExecStartPre drop-in).
#
# Trillian runs Tailscale DNS in "direct" mode: Pi-hole owns :53, so
# systemd-resolved has DNSStubListener=no. In direct mode tailscaled replaces
# /etc/resolv.conf with its own file and puts the original back on a clean stop.
#
# On a power loss that restore never happens. On the next boot tailscaled reads
# its own leftover file, takes the "resolvconf" in its header URL to mean
# openresolv, fails to set DNS, and runs with no upstream resolvers: every
# non-tailnet lookup returns SERVFAIL. Seen 2026-10-22 after the 10-20 power loss.
#
# This does what the clean stop would have done.
set -eu
RESOLV=/etc/resolv.conf
STUB=../run/systemd/resolve/stub-resolv.conf

if [ ! -L "$RESOLV" ] && grep -q 'generated by tailscale' "$RESOLV" 2>/dev/null; then
    ln -sfn "$STUB" "$RESOLV"
    logger -t tailscale-resolv-guard "restored $RESOLV -> $STUB (left over from an unclean tailscaled stop)"
fi
