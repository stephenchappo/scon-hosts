[Unit]
Description=Companion vault brief generation (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/companion
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=OLLAMA_ENDPOINT=http://deepthought:11434
EnvironmentFile=-%h/work/companion/.env
EnvironmentFile=-%h/work/companion/.vikunja.env
ExecStart=/bin/sh -c 'make vaults-sync-calendar vaults-sync-gmail vaults-brief-generated >> %h/work/obsidian-personal/.companion/brief.log 2>&1'
StandardOutput=journal
StandardError=journal
