[Unit]
Description=Codex remote control bridge (companion)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/scon/work/companion
Environment=PATH=/home/scon/.local/share/npm/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/scon/.local/share/npm/bin/codex remote-control -c approval_policy="never"
Restart=always
RestartSec=5
StandardOutput=append:/home/scon/.codex/remote-control-companion.log
StandardError=append:/home/scon/.codex/remote-control-companion.log

[Install]
WantedBy=default.target
