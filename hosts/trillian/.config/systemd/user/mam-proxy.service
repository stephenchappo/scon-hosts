[Unit]
Description=SOCKS5 tunnel to the Ultra seedbox for Prowlarr's MyAnonaMouse traffic
# MAM must only ever see the seedbox IP (46.232.211.79), never the home connection.
# Bound to the prowlarr_default Docker bridge gateway, so only containers on that
# network can use it. Prowlarr: Settings -> Indexers -> Indexer Proxies -> "seedbox" (tag mam).
# Approved by Stephen 2026-10-10.
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/ssh -N -D 172.23.0.1:1080 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 r0xyd0g@r0xyd0g.agate.usbx.me
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
