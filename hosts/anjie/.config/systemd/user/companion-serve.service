[Unit]
Description=Companion local web UI
After=network.target

[Service]
WorkingDirectory=/home/scon/work/companion
ExecStart=/home/scon/work/companion/.venv/bin/python -m companion.cli \
  --db .local/obsidian-homelab.sqlite3 \
  serve \
  --port 8282 \
  --embedding-endpoint http://deepthought:11434 \
  --embedding-model qwen3-embedding:4b \
  --generation-endpoint http://deepthought:11434 \
  --generation-model qwen3:8b \
  --profile docs/ranking/obsidian-homelab.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
