#!/usr/bin/env python3
"""secrets-readback PROJECT OLDFILE   (review 1, B3)

Before a plaintext secrets file is deleted, prove every value in it reads back from
Secrets Manager unchanged. Compares sha256 of each value; prints names and a verdict,
never a value. Exit 0 only if every name in OLDFILE matches.

OLDFILE lines: NAME=value, NAME: value, or `NAME` = value (a markdown table row
| NAME | value | also works). Lines that don't parse are listed as SKIPPED so a human
can check them; they never count as a pass.
"""
import hashlib, json, os, pathlib, re, subprocess, sys

HERE = pathlib.Path(os.path.realpath(__file__)).parent
conf = pathlib.Path(os.environ.get("BWS_PROJECTS_CONF", HERE.parent / "bws/projects.conf"))
tokdir = pathlib.Path(os.environ.get("BWS_TOKEN_DIR", pathlib.Path.home() / ".config/bws"))
NAME = r"[A-Za-z_][A-Za-z0-9_]*"
PATTERNS = [re.compile(rf"^\s*(?:export\s+)?`?({NAME})`?\s*[=:]\s*(.+?)\s*$"),
            re.compile(rf"^\s*\|\s*`?({NAME})`?\s*\|\s*`?([^|`]+?)`?\s*\|")]


def sha(v):
    return hashlib.sha256(v.encode()).hexdigest()


def parse(text):
    found, skipped = {}, []
    for n, line in enumerate(text.splitlines(), 1):
        s = line.strip()
        if not s or s.startswith(("#", "<!--", "|-", "| -", "|:", "| Name", "| name")):
            continue
        for p in PATTERNS:
            m = p.match(line)
            if m:
                v = m.group(2).strip().strip("'\"")
                found[m.group(1)] = sha(v)
                break
        else:
            skipped.append(n)
    return found, skipped


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    project, old = sys.argv[1], pathlib.Path(sys.argv[2])
    ids = dict(l.split()[:2] for l in conf.read_text().splitlines() if l.strip() and not l.startswith("#"))
    pid = ids.get(project)
    if not pid or pid == "TBD":
        sys.exit(f"no project id for {project} in {conf}")
    token = (tokdir / f"{project}.token").read_text().strip()
    out = subprocess.run(["bws", "secret", "list", pid, "--output", "json"], capture_output=True, text=True,
                         env={**os.environ, "BWS_ACCESS_TOKEN": token}, check=True).stdout
    remote = {s["key"]: sha(s["value"]) for s in json.loads(out)}
    local, skipped = parse(old.read_text())
    bad = 0
    for name in sorted(local):
        if name not in remote:
            verdict, bad = "MISSING from Secrets Manager", bad + 1
        elif remote[name] != local[name]:
            verdict, bad = "DIFFERS", bad + 1
        else:
            verdict = "ok"
        print(f"{verdict:30} {name}")
    for n in skipped:
        print(f"{'SKIPPED (check by hand)':30} line {n}")
    print(f"{len(local) - bad}/{len(local)} match; {len(skipped)} line(s) skipped")
    sys.exit(1 if bad or skipped or not local else 0)


if __name__ == "__main__":
    main()
