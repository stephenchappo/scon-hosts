#!/usr/bin/env bash
# secrets-backup PROJECT   (target design 2.8: age files stay as the offline backup)
# Export one Secrets Manager project to an age-encrypted file in _project-meta/secrets/,
# re-run after every rotation. The plaintext only ever exists in a pipe.
#   AGE_RECIPIENTS_FILE  age recipients (public keys), default _project-meta/secrets/recipients.txt
set -euo pipefail
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
project=${1:?usage: secrets-backup PROJECT}
CONF=${BWS_PROJECTS_CONF:-$HERE/../bws/projects.conf}
META=${SECRETS_META_DIR:-$HOME/work/_project-meta/secrets}
REC=${AGE_RECIPIENTS_FILE:-$META/recipients.txt}
id=$(awk -v p="$project" '$1==p {print $2}' "$CONF")
[ -n "$id" ] && [ "$id" != TBD ] || { echo "no project id for $project" >&2; exit 65; }
[ -s "$REC" ] || { echo "no age recipients at $REC" >&2; exit 66; }
out="$META/bws-$project-$(date -u +%Y-%m-%d).json.age"
BWS_ACCESS_TOKEN=$(cat "${BWS_TOKEN_DIR:-$HOME/.config/bws}/$project.token") \
  bws secret list "$id" --output json \
  | python3 -c 'import json,sys; print(json.dumps({s["key"]: s["value"] for s in json.load(sys.stdin)}, sort_keys=True))' \
  | age -R "$REC" -o "$out.tmp"
mv "$out.tmp" "$out"
echo "wrote $out"
